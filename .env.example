# Brand and runtime
PERSONA_NAME=Layla
STORE_NAME=Souqly
APP_ENVIRONMENT=development
# LLM provider credentials and per-node model settings.
GOOGLE_API_KEY=replace-me
GEMINI_API_TIER=free
NODE_MODELS__ASSISTANT__PROVIDER=google_genai
NODE_MODELS__ASSISTANT__MODEL=gemini-3.1-flash-lite
NODE_MODELS__PROMO_JUDGE__PROVIDER=google_genai
NODE_MODELS__PROMO_JUDGE__MODEL=gemini-3-flash-preview
NODE_MODELS__SAFETY_CHECK__PROVIDER=google_genai
NODE_MODELS__SAFETY_CHECK__MODEL=gemini-3.1-flash-lite
NODE_MODELS__SAFETY_CHECK__THINKING_BUDGET=0
NODE_MODELS__EVAL_JUDGE__PROVIDER=google_genai
NODE_MODELS__EVAL_JUDGE__MODEL=gemini-3.1-flash-lite

# Fast safety classifier (Jev via OpenRouter). Gemini decides whenever Jev is
# unsure, slow, failing, or turned off. Keep JEV_ENABLED=false to use Gemini only.
JEV_ENABLED=false
OPENROUTER_API_KEY=replace-me
JEV_MODEL=typesafe/jev-1.13
JEV_URL=https://openrouter.ai/api/alpha/decisions
JEV_TIMEOUT_SECONDS=1.5
# Score >= ACT is a firm alarm; every score < CLEAR is a firm allow; between = Gemini.
JEV_ACT_THRESHOLD=0.8
JEV_CLEAR_THRESHOLD=0.2
JEV_MAX_MESSAGE_CHARS=600

# Iteration 4 warning: src/customer_service/data/promotions.json contains only
# synthetic development offers. Do not enable this catalog for live customers.

# Required once staff/admin routes are enabled. Use a long random value.
STAFF_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_ALLOWED_EMAILS=["agent@example.com"]
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id
ADMIN_COOKIE_DOMAIN=
ADMIN_COOKIE_SECURE=false
ADMIN_API_URL=http://localhost:8000
CSRF_COOKIE_NAME=customer_service_csrf
STAFF_SESSION_COOKIE_NAME=customer_service_staff_session
WEBSOCKET_TOKEN_TTL_SECONDS=300
# Identity verification (see docs/identity-verification.md).
# BOT_API_KEY=replace-with-a-long-random-secret
# VERIFICATION_HASH_KEY=replace-with-a-long-random-secret
VERIFICATION_TTL_SECONDS=7200
VERIFICATION_MAX_THREAD_FAILURES=3
VERIFICATION_KEY_FAILURE_LIMIT=5

# Introduced by later iterations; all environment configuration lives here.
POSTGRES_DSN=postgresql://customer_service:customer_service@localhost:5432/customer_service
LANGGRAPH_STRICT_MSGPACK=true
VOYAGE_API_KEY=replace-me
VOYAGE_MODEL=voyage-3.5-lite
VOYAGE_EMBEDDING_DIMENSIONS=1024
FAQ_CORPUS_VERSION=v2
# Set this from `python -m customer_service.retrieval.index_faqs --calibrate`.
# FAQ_MIN_SIMILARITY=0.50098
# FAQ_MIN_MARGIN=0.014584
# Query logging is redacted with redact_text; enabled by default in development/CI.
# FAQ_LOG_QUERIES=true
# FAQ_EMBEDDING_RETRIES=2
# FAQ_EMBEDDING_RETRY_DELAY_SECONDS=0.25
# Local development convenience only. Keep false in deployed environments.
FAQ_SYNC_ON_STARTUP=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=customer-service-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_SAMPLE_RATE=1.0
# Use a long random value outside source control when tracing is enabled.
TRACE_THREAD_HASH_SALT=replace-with-a-long-random-secret
META_VERIFY_TOKEN=replace-me
META_APP_SECRET=replace-me
META_PHONE_NUMBER_ID=replace-me
META_ACCESS_TOKEN=replace-me
META_GRAPH_API_VERSION=v26.0
# Create with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WHATSAPP_PHONE_ENCRYPTION_KEY=replace-with-a-fernet-key
WHATSAPP_THREAD_HMAC_KEY=replace-with-a-long-random-secret
# Deployment-owned templates only. Parameter count is strictly validated.
WHATSAPP_TEMPLATE_CATALOG=[]
WORKER_POLL_SECONDS=1
WORKER_MAX_ATTEMPTS=8
WHATSAPP_SERVICE_WINDOW_HOURS=24
FRONTEND_ORIGIN=http://localhost:3000
