# Brand and runtime
PERSONA_NAME=Layla
STORE_NAME=Souqly

# LLM provider credentials and per-node model settings.
GOOGLE_API_KEY=replace-me
GEMINI_API_TIER=free
NODE_MODELS__ASSISTANT__PROVIDER=google_genai
NODE_MODELS__ASSISTANT__MODEL=gemini-3.1-flash-lite
NODE_MODELS__PROMO_JUDGE__PROVIDER=google_genai
NODE_MODELS__PROMO_JUDGE__MODEL=gemini-3-flash-preview
NODE_MODELS__SAFETY_CHECK__PROVIDER=google_genai
NODE_MODELS__SAFETY_CHECK__MODEL=gemini-3.1-flash-lite
NODE_MODELS__EVAL_JUDGE__PROVIDER=google_genai
NODE_MODELS__EVAL_JUDGE__MODEL=gemini-3.1-flash-lite

# Iteration 4 warning: src/customer_service/data/promotions.json contains only
# synthetic development offers. Do not enable this catalog for live customers.

# Required once staff/admin routes are enabled. Use a long random value.
STAFF_SESSION_SECRET=replace-with-a-long-random-secret
ADMIN_ALLOWED_EMAILS=["agent@example.com"]
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-client-id

# Introduced by later iterations; all environment configuration lives here.
POSTGRES_DSN=postgresql://customer_service:customer_service@localhost:5432/customer_service
LANGGRAPH_STRICT_MSGPACK=true
VOYAGE_API_KEY=replace-me
VOYAGE_MODEL=voyage-3.5-lite
VOYAGE_EMBEDDING_DIMENSIONS=1024
FAQ_CORPUS_VERSION=v1
# Set this from `python -m customer_service.retrieval.index_faqs --calibrate`.
# FAQ_MIN_SIMILARITY=<value printed by the calibration command>
# Local development convenience only. Keep false in deployed environments.
FAQ_SYNC_ON_STARTUP=true
LANGSMITH_API_KEY=replace-me
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=customer-service-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_SAMPLE_RATE=1.0
# Use a long random value outside source control when tracing is enabled.
TRACE_THREAD_HASH_SALT=replace-with-a-long-random-secret
META_VERIFY_TOKEN=replace-me
META_APP_SECRET=replace-me
META_PHONE_NUMBER_ID=replace-me
META_ACCESS_TOKEN=replace-me
FRONTEND_ORIGIN=http://localhost:3000
